if SHIELD_TEMPEST_DUX_LEFT || SHIELD_TEMPEST_DUX_RIGHT

config ZMK_KEYBOARD_NAME
	default "tempest-dux"

config ZMK_SPLIT
	default y

endif

# ── Option (A) bring-up default: RIGHT = central (trackball is local to central) ──
if SHIELD_TEMPEST_DUX_RIGHT

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

# Enable the badjeff PMW3610 trackball driver on the right half only.
# The symbol has no default and only its deps (INPUT via ZMK_POINTING, and
# DT_HAS_PIXART_PMW3610_ALT_ENABLED from the overlay node) are satisfied here.
config PMW3610_ALT
	default y

endif

# ── Option (B) rae_dux parity (LEFT central, trackball forwarded) ──
# Delete the block above and use this instead, then add a `zmk,input-split`
# on the central and move the trackball under it on the right peripheral:
# if SHIELD_TEMPEST_DUX_LEFT
# config ZMK_SPLIT_BLE_ROLE_CENTRAL
#     default y
# endif
